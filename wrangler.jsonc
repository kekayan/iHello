{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-chat-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "hello.kekayan.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/agents/*", "/config", "/admin", "/admin/*", "/api/*", "/feedback"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  "triggers": { "crons": ["0 3 * * *"] },
  "ai": {
    "binding": "AI"
  },
  // Unused in product path (Vectorize-only knowledge). Kept so dashboard binding stays intact.
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "chat-agent-chunks"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat_agent",
      "database_id": "44b49c27-9f35-4bbe-9fec-b47281595250",
      "migrations_dir": "./migrations"
    }
  ],
  "analytics_engine_datasets": [
    { "binding": "AE", "dataset": "chat_agent_events" }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "AI_SEARCH_INSTANCE": "company-site",
    "CF_ACCOUNT_ID": "53d2fe8f27280c1b8d4aa769031dc667",
    "AI_GATEWAY_ID": "default",
    "MODEL_MAIN_DEFAULT": "openai/gpt-5.6-luna",
    "MODEL_SMALL": "openai/gpt-5.6-luna",
    "TURNSTILE_SITE_KEY": "REPLACE",
    "NOTIFY_TO": "REPLACE@company.co.nz",
    "NOTIFY_FROM": "widget@REPLACE-domain.co.nz",
    "BOOKING_URL": "REPLACE"
  }
}
