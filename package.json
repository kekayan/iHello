{
  "name": "site-chat-agent",
  "version": "1.0.0",
  "private": true,
  "description": "iHello — site chat agent on Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:admin": "npm run dev --prefix admin",
    "build:admin": "npm run build --prefix admin",
    "deploy": "npm run build:admin && wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test:personas": "node --experimental-strip-types test/run-personas.ts",
    "db:migrate:local": "wrangler d1 migrations apply chat_agent --local",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/openai": "^4.0.53",
    "@cloudflare/ai-chat": "^0.11.0",
    "agents": "0.22.0",
    "ai": "^7.0.85",
    "jose": "^6.2.10",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260830.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "4.127.1"
  }
}
